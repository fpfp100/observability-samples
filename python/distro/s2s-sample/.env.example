# Agent Hosting Environment Configuration (S2S -- Server-to-Server)
#
# This sample uses client_credentials (S2S) flow to acquire the observability token.
# No agentic user authorization is needed -- the agent acquires tokens using its own
# app identity via get_agentic_application_token + client_credentials.

CONNECTIONSMAP__0__SERVICEURL=*
CONNECTIONSMAP__0__CONNECTION=SERVICE_CONNECTION

CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTSECRET=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=

# NOTE: No agentic_type or agentic_scopes needed for S2S flow.
# The S2S token acquisition uses get_agentic_application_token (client_credentials + fmi_path)
# followed by client_credentials with the agent instance identity for the observability scope.

# Agent 365 observability
ENABLE_A365_OBSERVABILITY=true
ENABLE_A365_OBSERVABILITY_EXPORTER=true

CLUSTER_CATEGORY=prod
# A365_OBSERVABILITY_DOMAIN_OVERRIDE=     # optional
# A365_OBSERVABILITY_SCOPE_OVERRIDE=      # optional
