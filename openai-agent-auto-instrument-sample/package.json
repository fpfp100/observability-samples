{
  "name": "openai-agent-auto-instrument-sample",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "dev": "nodemon --watch src/*.ts --exec tsx src/index.ts",
    "test-tool": "agentsplayground",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "install:clean": "npm run clean && npm install",
    "clean": "rimraf dist node_modules package-lock.json"
  },
  "keywords": [
    "openai",
    "agents",
    "instrumentation",
    "observability",
    "sample"
  ],
  "author": "Microsoft Corporation",
  "license": "MIT",
  "description": "Sample OpenAI agent with instrumentation using Microsoft Agent 365 SDK",
  "dependencies": {
    "@microsoft/agents-a365-observability": "^0.2.0-preview.3",
    "@microsoft/agents-a365-observability-extensions-openai": "^0.2.0-preview.3",
    "@microsoft/agents-a365-observability-hosting": "^0.2.0-preview.3",
    "@microsoft/agents-a365-runtime": "^0.2.0-preview.3",
    "@microsoft/agents-a365-tooling-extensions-openai": "^0.2.0-preview.3",
    "@microsoft/agents-activity": "^1.3.1",
    "@microsoft/agents-hosting": "^1.3.1",
    "@openai/agents": "^0.7.0",
    "@openai/agents-core": "^0.7.0",
    "dotenv": "^17.2.2",
    "express": "^5.2.0",
    "hono": "^4.11.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@jest/globals": "^30.2.0",
    "@microsoft/m365agentsplayground": "^0.2.18",
    "@types/express": "^5.0.0",
    "@types/node": "^20.17.0",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "eslint": "^9.39.1",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "rimraf": "^6.0.0",
    "ts-jest": "^29.4.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
