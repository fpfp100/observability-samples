{
  "name": "langchain-sample",
  "version": "2025.11.6",
  "description": "Sample agent integrating LangChain Agents with Microsoft 365 Agents SDK and Microsoft Agent 365 SDK",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon --watch src --exec node --loader ts-node/esm src/index.ts",
    "test-tool": "agentsplayground",
    "eval": "node --env-file .env src/evals/index.js",
    "build": "tsc"
  },
  "keywords": [
    "langchain",
    "microsoft-365",
    "agent",
    "ai"
  ],
  "license": "MIT",
  "dependencies": {
    "@langchain/core": "^1.1.32",
    "@langchain/langgraph": "^1.2.2",
    "@langchain/mcp-adapters": "^1.1.3",
    "@langchain/openai": "^1.4.4",
    "@microsoft/agents-a365-notifications": "^0.2.0-preview.3",
    "@microsoft/agents-a365-observability": "^0.2.0-preview.3",
    "@microsoft/agents-a365-observability-extensions-langchain": "^0.2.0-preview.3",
    "@microsoft/agents-a365-observability-hosting": "^0.2.0-preview.3",
    "@microsoft/agents-a365-runtime": "^0.2.0-preview.3",
    "@microsoft/agents-a365-tooling": "^0.2.0-preview.3",
    "@microsoft/agents-a365-tooling-extensions-langchain": "^0.2.0-preview.3",
    "@microsoft/agents-activity": "^1.3.1",
    "@microsoft/agents-hosting": "^1.3.1",
    "dotenv": "^17.2.2",
    "express": "^5.2.0",
    "langchain": "^1.2.31",
    "node-fetch": "^3.3.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@azure/monitor-opentelemetry-exporter": "^1.0.0-beta.32",
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@microsoft/m365agentsplayground": "^0.2.18",
    "@types/express": "^5.0.0",
    "@types/node": "^20.17.0",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2"
  }
}
